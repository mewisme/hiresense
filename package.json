{
  "name": "@hiresense/root",
  "version": "0.0.0",
  "private": true,
  "author": "Nguyễn Mậu Minh",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.22.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mewisme/hiresense.git"
  },
  "homepage": "https://github.com/mewisme/hiresense",
  "bugs": {
    "url": "https://github.com/mewisme/hiresense/issues"
  },
  "scripts": {
    "dev:web": "pnpm --filter @hiresense/web dev",
    "dev:api": "pnpm --filter @hiresense/api start:dev",
    "dev:ai": "pnpm --filter @hiresense/ai dev",
    "prisma:generate": "pnpm --filter @hiresense/api prisma:generate",
    "prisma:migrate": "pnpm --filter @hiresense/api prisma:migrate",
    "prisma:migrate:dev": "pnpm --filter @hiresense/api prisma:migrate:dev",
    "prisma:migrate:reset": "pnpm --filter @hiresense/api prisma:migrate:reset",
    "prisma:studio": "pnpm --filter @hiresense/api prisma:studio",
    "build": "pnpm -r --if-present build",
    "build:web": "pnpm --filter @hiresense/web build",
    "build:api": "pnpm --filter @hiresense/api build",
    "build:ai": "pnpm --filter @hiresense/ai build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "compile:all": "pnpm -r --if-present compile:all",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ts:version": "tsc --version"
  },
  "devDependencies": {
    "eslint": "latest",
    "prettier": "latest",
    "typescript": "6"
  }
}