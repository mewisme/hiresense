# HireSense local environment template
# Copy to `.env` at the repo root (Compose reads this) and into apps as needed.

# --- Compose / Postgres ---
COMPOSE_PROFILES=dev
POSTGRES_DB=hiresense
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- API (apps/api/.env) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hiresense?schema=public
PORT=4000
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=30000
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
STORAGE_PROVIDER=discloud
DISCLOUD_CHANNEL_ID=
DISCLOUD_BOT_TOKENS=
DISCLOUD_REQUEST_TIMEOUT_MS=120000
DISCLOUD_MAX_ATTEMPTS=5
DISCLOUD_CHUNK_SIZE_BYTES=8388608
DISCLOUD_UPLOAD_WORKERS=3

# --- Web (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
