{
  "info": {
    "_postman_id": "c525698e-e403-4344-82db-hiresense-auth-logout",
    "name": "Auth - Logout",
    "description": "HireSense logout and revoked-session test cases",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api"
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Success",
      "item": [
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Expected HTTP 204. Revokes the current AuthSession."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Failure",
      "item": [
        {
          "name": "Use Revoked Access Token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Run after Logout. Expected HTTP 401 because the AuthSession has been revoked."
          },
          "response": []
        }
      ]
    }
  ]
}