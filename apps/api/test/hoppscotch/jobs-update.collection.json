{
  "info": {
    "_postman_id": "383aa53f-77f9-447c-acd2-ff53b7e0cdb1",
    "name": "HireSense - Update Job",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "companyId",
      "value": ""
    },
    {
      "key": "jobId",
      "value": ""
    },
    {
      "key": "skillId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Update Job Draft Content",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Senior Backend Developer\",\n  \"experienceMinMonths\": 24,\n  \"experienceMaxMonths\": 60,\n  \"salaryMin\": \"20000000\",\n  \"salaryMax\": \"40000000\",\n  \"salaryCurrency\": \"VND\"\n}"
        },
        "url": "{{baseUrl}}/companies/{{companyId}}/jobs/{{jobId}}"
      }
    },
    {
      "name": "Replace Job Draft Skills",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"skills\": [\n    {\n      \"skillId\": \"{{skillId}}\",\n      \"importance\": 5,\n      \"isRequired\": true,\n      \"weight\": \"1\",\n      \"minExperienceMonths\": 24\n    }\n  ]\n}"
        },
        "url": "{{baseUrl}}/companies/{{companyId}}/jobs/{{jobId}}"
      }
    },
    {
      "name": "Clear Job Draft Skills",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"skills\": []\n}"
        },
        "url": "{{baseUrl}}/companies/{{companyId}}/jobs/{{jobId}}"
      }
    }
  ]
}