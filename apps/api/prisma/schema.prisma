generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "commonjs"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code        String     @unique(map: "roles_code_uq")
  name        String
  description String?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  userRoles   UserRole[]

  @@map("roles")
}

model User {
  id                    String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email                 String                    @unique(map: "users_email_uq") @db.Citext
  passwordHash          String                    @map("password_hash")
  status                String                    @default("ACTIVE")
  emailVerifiedAt       DateTime?                 @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt           DateTime?                 @map("last_login_at") @db.Timestamptz(6)
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?                 @map("deleted_at") @db.Timestamptz(6)
  stageChanges          ApplicationStageHistory[] @relation("StageChangedBy")
  sessions              AuthSession[]
  authTokens            AuthToken[]
  candidateProfile      CandidateProfile?
  createdCompanies      Company[]                 @relation("CompanyCreatedBy")
  memberships           CompanyMembership[]
  uploadedFiles         FileObject[]              @relation("FileUploadedBy")
  createdJobVersions    JobVersion[]              @relation("JobVersionCreatedBy")
  createdJobs           Job[]                     @relation("JobCreatedBy")
  recruiterProfile      RecruiterProfile?
  createdResumeVersions ResumeVersion[]           @relation("ResumeVersionCreatedBy")
  userRoles             UserRole[]

  @@map("users")
}

model UserRole {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  role      Role     @relation(fields: [roleId], references: [id], onUpdate: NoAction, map: "user_roles_role_id_fk")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_roles_user_id_fk")

  @@unique([userId, roleId], map: "user_roles_user_role_uq")
  @@map("user_roles")
}

model AuthSession {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  deviceName       String?   @map("device_name")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address") @db.Inet
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "auth_sessions_user_id_fk")

  @@index([userId, expiresAt], map: "auth_sessions_user_expiry_idx")
  @@map("auth_sessions")
}

model AuthToken {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenType  String    @map("token_type")
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "auth_tokens_user_id_fk")

  @@index([userId, tokenType, expiresAt], map: "auth_tokens_user_type_idx")
  @@map("auth_tokens")
}

model CandidateProfile {
  id                       String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                   String        @unique(map: "candidate_profiles_user_id_uq") @map("user_id") @db.Uuid
  fullName                 String        @map("full_name")
  phone                    String?
  headline                 String?
  summary                  String?
  city                     String?
  region                   String?
  countryCode              String?       @map("country_code") @db.Char(2)
  timezone                 String        @default("UTC")
  experienceMonthsDeclared Int?          @map("experience_months_declared")
  portfolioUrl             String?       @map("portfolio_url")
  githubUrl                String?       @map("github_url")
  linkedinUrl              String?       @map("linkedin_url")
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  applications             Application[]
  user                     User          @relation(fields: [userId], references: [id], onUpdate: NoAction, map: "candidate_profiles_user_id_fk")
  resumes                  Resume?

  @@map("candidate_profiles")
}

model RecruiterProfile {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @unique(map: "recruiter_profiles_user_id_uq") @map("user_id") @db.Uuid
  fullName  String   @map("full_name")
  phone     String?
  jobTitle  String?  @map("job_title")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onUpdate: NoAction, map: "recruiter_profiles_user_id_fk")

  @@map("recruiter_profiles")
}

model Company {
  id                String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name              String
  slug              String              @unique(map: "companies_slug_uq")
  description       String?
  websiteUrl        String?             @map("website_url")
  companySizeMin    Int?                @map("company_size_min")
  companySizeMax    Int?                @map("company_size_max")
  status            String              @default("ACTIVE")
  createdByUserId   String              @map("created_by_user_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?           @map("deleted_at") @db.Timestamptz(6)
  createdBy         User                @relation("CompanyCreatedBy", fields: [createdByUserId], references: [id], onUpdate: NoAction, map: "companies_created_by_user_id_fk")
  memberships       CompanyMembership[]
  jobs              Job[]
  recruitmentStages RecruitmentStage[]

  @@index([status])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "companies_name_trgm_idx", type: Gin)
  @@map("companies")
}

model CompanyMembership {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  role      String
  status    String    @default("ACTIVE")
  joinedAt  DateTime? @map("joined_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  company   Company   @relation(fields: [companyId], references: [id], onUpdate: NoAction, map: "company_memberships_company_id_fk")
  user      User      @relation(fields: [userId], references: [id], onUpdate: NoAction, map: "company_memberships_user_id_fk")

  @@unique([companyId, userId], map: "company_memberships_company_user_uq")
  @@index([userId, status], map: "company_memberships_user_status_idx")
  @@map("company_memberships")
}

model SkillCategory {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code        String   @unique(map: "skill_categories_code_uq")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  skills      Skill[]

  @@map("skill_categories")
}

model Skill {
  id               String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  categoryId       String?           @map("category_id") @db.Uuid
  name             String
  normalizedName   String            @unique(map: "skills_normalized_name_uq") @map("normalized_name")
  description      String?
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  jobVersionSkills JobVersionSkill[]
  resumeSkills     ResumeSkill[]
  category         SkillCategory?    @relation(fields: [categoryId], references: [id], onUpdate: NoAction, map: "skills_category_id_fk")

  @@index([categoryId, isActive], map: "skills_category_active_idx")
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], map: "skills_normalized_name_trgm_idx", type: Gin)
  @@map("skills")
}

model FileObject {
  id               String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  storageProvider  String            @map("storage_provider")
  bucket           String
  objectKey        String            @map("object_key")
  originalFilename String            @map("original_filename")
  mimeType         String            @map("mime_type")
  sizeBytes        BigInt            @map("size_bytes")
  sha256           String?
  uploadedByUserId String            @map("uploaded_by_user_id") @db.Uuid
  status           String            @default("UPLOADING")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt        DateTime?         @map("deleted_at") @db.Timestamptz(6)
  discordParts     DiscordFilePart[]
  uploadedBy       User              @relation("FileUploadedBy", fields: [uploadedByUserId], references: [id], onUpdate: NoAction, map: "file_objects_uploaded_by_user_id_fk")
  resumeVersions   ResumeVersion[]

  @@unique([storageProvider, bucket, objectKey], map: "file_objects_storage_key_uq")
  @@map("file_objects")
}

model DiscordStorageChunk {
  id                 String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  channelId          String            @map("channel_id") @db.VarChar(32)
  sha256             String            @db.VarChar(64)
  sizeBytes          BigInt            @map("size_bytes")
  status             String            @default("UPLOADING") @db.VarChar(32)
  messageId          String?           @map("message_id") @db.VarChar(32)
  attachmentId       String?           @map("attachment_id") @db.VarChar(32)
  attachmentFilename String?           @map("attachment_filename")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?         @map("deleted_at") @db.Timestamptz(6)
  fileParts          DiscordFilePart[]

  @@unique([channelId, sha256], map: "discord_storage_chunks_channel_sha256_uq")
  @@index([status])
  @@index([channelId, messageId], map: "discord_storage_chunks_message_idx")
  @@map("discord_storage_chunks")
}

model DiscordFilePart {
  id           String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  fileObjectId String              @map("file_object_id") @db.Uuid
  chunkId      String              @map("chunk_id") @db.Uuid
  ordinal      Int
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  chunk        DiscordStorageChunk @relation(fields: [chunkId], references: [id], onUpdate: NoAction, map: "discord_file_parts_chunk_fk")
  fileObject   FileObject          @relation(fields: [fileObjectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "discord_file_parts_file_object_fk")

  @@unique([fileObjectId, ordinal], map: "discord_file_parts_file_ordinal_uq")
  @@index([chunkId])
  @@map("discord_file_parts")
}

model Resume {
  id                                                             String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  candidateProfileId                                             String           @unique(map: "resumes_one_default_per_candidate_uq", where: raw("((is_default = true) AND (deleted_at IS NULL))")) @map("candidate_profile_id") @db.Uuid
  name                                                           String
  isDefault                                                      Boolean          @default(false) @map("is_default")
  createdAt                                                      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                                      DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt                                                      DateTime?        @map("deleted_at") @db.Timestamptz(6)
  currentVersionId                                               String?          @map("current_version_id") @db.Uuid
  versions                                                       ResumeVersion[]  @relation("ResumeVersions")
  candidateProfile                                               CandidateProfile @relation(fields: [candidateProfileId], references: [id], onUpdate: NoAction, map: "resumes_candidate_profile_id_fk")
  resume_versions_resumes_current_version_id_idToresume_versions ResumeVersion?   @relation("resumes_current_version_id_idToresume_versions", fields: [currentVersionId, id], references: [id, resumeId], onUpdate: NoAction, map: "resumes_current_version_belongs_to_resume_fk")

  @@index([candidateProfileId, deletedAt], map: "resumes_candidate_active_idx")
  @@map("resumes")
}

model ResumeVersion {
  id                                                     String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  resumeId                                               String           @map("resume_id") @db.Uuid
  versionNo                                              Int              @map("version_no")
  fileObjectId                                           String           @map("file_object_id") @db.Uuid
  createdByUserId                                        String           @map("created_by_user_id") @db.Uuid
  createdAt                                              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  applications                                           Application[]
  parseRuns                                              ResumeParseRun[]
  createdBy                                              User             @relation("ResumeVersionCreatedBy", fields: [createdByUserId], references: [id], onUpdate: NoAction, map: "resume_versions_created_by_user_id_fk")
  fileObject                                             FileObject       @relation(fields: [fileObjectId], references: [id], onUpdate: NoAction, map: "resume_versions_file_object_id_fk")
  resume                                                 Resume           @relation("ResumeVersions", fields: [resumeId], references: [id], onUpdate: NoAction, map: "resume_versions_resume_id_fk")
  resumes_resumes_current_version_id_idToresume_versions Resume[]         @relation("resumes_current_version_id_idToresume_versions")

  @@unique([id, resumeId], map: "resume_versions_id_resume_uq")
  @@unique([resumeId, versionNo], map: "resume_versions_resume_version_uq")
  @@index([resumeId, createdAt(sort: Desc)], map: "resume_versions_resume_created_idx")
  @@map("resume_versions")
}

model Job {
  id                                                              String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId                                                       String        @map("company_id") @db.Uuid
  createdByUserId                                                 String        @map("created_by_user_id") @db.Uuid
  slug                                                            String
  status                                                          String        @default("DRAFT")
  firstPublishedAt                                                DateTime?     @map("first_published_at") @db.Timestamptz(6)
  closedAt                                                        DateTime?     @map("closed_at") @db.Timestamptz(6)
  createdAt                                                       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                                       DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt                                                       DateTime?     @map("deleted_at") @db.Timestamptz(6)
  currentPublishedVersionId                                       String?       @map("current_published_version_id") @db.Uuid
  applications                                                    Application[]
  versions                                                        JobVersion[]  @relation("JobVersions")
  company                                                         Company       @relation(fields: [companyId], references: [id], onUpdate: NoAction, map: "jobs_company_id_fk")
  createdBy                                                       User          @relation("JobCreatedBy", fields: [createdByUserId], references: [id], onUpdate: NoAction, map: "jobs_created_by_user_id_fk")
  job_versions_jobs_current_published_version_id_idTojob_versions JobVersion?   @relation("jobs_current_published_version_id_idTojob_versions", fields: [currentPublishedVersionId, id], references: [id, jobId], onUpdate: NoAction, map: "jobs_current_published_version_belongs_to_job_fk")

  @@unique([companyId, slug], map: "jobs_company_slug_uq")
  @@index([companyId, status], map: "jobs_company_status_idx")
  @@map("jobs")
}

model JobVersion {
  id                                                      String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  jobId                                                   String                @map("job_id") @db.Uuid
  versionNo                                               Int                   @map("version_no")
  versionStatus                                           String                @default("DRAFT") @map("version_status")
  title                                                   String
  summary                                                 String?
  description                                             String
  responsibilities                                        String?
  benefits                                                String?
  employmentType                                          String?               @map("employment_type")
  workplaceType                                           String?               @map("workplace_type")
  experienceMinMonths                                     Int?                  @map("experience_min_months")
  experienceMaxMonths                                     Int?                  @map("experience_max_months")
  salaryMin                                               Decimal?              @map("salary_min") @db.Decimal(19, 4)
  salaryMax                                               Decimal?              @map("salary_max") @db.Decimal(19, 4)
  salaryCurrency                                          String?               @map("salary_currency") @db.Char(3)
  createdByUserId                                         String                @map("created_by_user_id") @db.Uuid
  publishedAt                                             DateTime?             @map("published_at") @db.Timestamptz(6)
  createdAt                                               DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  matchRuns                                               ApplicationMatchRun[]
  applications                                            Application[]
  skills                                                  JobVersionSkill[]
  createdBy                                               User                  @relation("JobVersionCreatedBy", fields: [createdByUserId], references: [id], onUpdate: NoAction, map: "job_versions_created_by_user_id_fk")
  job                                                     Job                   @relation("JobVersions", fields: [jobId], references: [id], onUpdate: NoAction, map: "job_versions_job_id_fk")
  jobs_jobs_current_published_version_id_idTojob_versions Job[]                 @relation("jobs_current_published_version_id_idTojob_versions")

  @@unique([id, jobId], map: "job_versions_id_job_uq")
  @@unique([jobId, versionNo], map: "job_versions_job_version_uq")
  @@index([jobId, publishedAt(sort: Desc)], map: "job_versions_job_published_idx")
  @@index([title(ops: raw("gin_trgm_ops"))], map: "job_versions_title_trgm_idx", type: Gin)
  @@map("job_versions")
}

model JobVersionSkill {
  id                  String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  jobVersionId        String             @map("job_version_id") @db.Uuid
  skillId             String             @map("skill_id") @db.Uuid
  importance          Int                @default(3) @db.SmallInt
  isRequired          Boolean            @default(true) @map("is_required")
  weight              Decimal            @default(1.000000) @db.Decimal(7, 6)
  minExperienceMonths Int?               @map("min_experience_months")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  jobVersion          JobVersion         @relation(fields: [jobVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "job_version_skills_job_version_id_fk")
  skill               Skill              @relation(fields: [skillId], references: [id], onUpdate: NoAction, map: "job_version_skills_skill_id_fk")
  matchResults        MatchSkillResult[]

  @@unique([jobVersionId, skillId], map: "job_version_skills_version_skill_uq")
  @@index([skillId, isRequired], map: "job_version_skills_skill_required_idx")
  @@map("job_version_skills")
}

model RecruitmentStage {
  id              String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId       String?                   @map("company_id") @db.Uuid
  code            String
  name            String
  ordinal         Int
  isTerminal      Boolean                   @default(false) @map("is_terminal")
  terminalOutcome String?                   @map("terminal_outcome")
  isActive        Boolean                   @default(true) @map("is_active")
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                  @default(now()) @map("updated_at") @db.Timestamptz(6)
  stageFrom       ApplicationStageHistory[] @relation("StageHistoryFrom")
  stageTo         ApplicationStageHistory[] @relation("StageHistoryTo")
  applications    Application[]
  company         Company?                  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "recruitment_stages_company_id_fk")

  @@unique([companyId, code], map: "recruitment_stages_company_code_uq")
  @@map("recruitment_stages")
}

model Application {
  id                 String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  jobId              String                    @map("job_id") @db.Uuid
  jobVersionId       String                    @map("job_version_id") @db.Uuid
  candidateProfileId String                    @map("candidate_profile_id") @db.Uuid
  resumeVersionId    String                    @map("resume_version_id") @db.Uuid
  currentStageId     String                    @map("current_stage_id") @db.Uuid
  source             String                    @default("DIRECT")
  coverLetter        String?                   @map("cover_letter")
  appliedAt          DateTime                  @default(now()) @map("applied_at") @db.Timestamptz(6)
  withdrawnAt        DateTime?                 @map("withdrawn_at") @db.Timestamptz(6)
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                  @default(now()) @map("updated_at") @db.Timestamptz(6)
  currentMatchRunId  String?                   @map("current_match_run_id") @db.Uuid
  matchRuns          ApplicationMatchRun[]     @relation("ApplicationMatchRuns")
  history            ApplicationStageHistory[]
  candidateProfile   CandidateProfile          @relation(fields: [candidateProfileId], references: [id], onUpdate: NoAction, map: "applications_candidate_profile_id_fk")
  currentMatchRun    ApplicationMatchRun?      @relation("ApplicationCurrentMatchRun", fields: [currentMatchRunId, id], references: [id, applicationId], onUpdate: NoAction, map: "applications_current_match_run_belongs_to_application_fk")
  currentStage       RecruitmentStage          @relation(fields: [currentStageId], references: [id], onUpdate: NoAction, map: "applications_current_stage_id_fk")
  job                Job                       @relation(fields: [jobId], references: [id], onUpdate: NoAction, map: "applications_job_id_fk")
  jobVersion         JobVersion                @relation(fields: [jobVersionId], references: [id], onUpdate: NoAction, map: "applications_job_version_id_fk")
  resumeVersion      ResumeVersion             @relation(fields: [resumeVersionId], references: [id], onUpdate: NoAction, map: "applications_resume_version_id_fk")

  @@unique([jobId, candidateProfileId], map: "applications_job_candidate_uq")
  @@index([candidateProfileId, appliedAt(sort: Desc)], map: "applications_candidate_applied_idx")
  @@index([jobId, currentStageId, appliedAt(sort: Desc)], map: "applications_job_stage_applied_idx")
  @@map("applications")
}

model ApplicationStageHistory {
  id              String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  applicationId   String            @map("application_id") @db.Uuid
  fromStageId     String?           @map("from_stage_id") @db.Uuid
  toStageId       String            @map("to_stage_id") @db.Uuid
  changedByUserId String?           @map("changed_by_user_id") @db.Uuid
  note            String?
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  application     Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "application_stage_history_application_id_fk")
  changedBy       User?             @relation("StageChangedBy", fields: [changedByUserId], references: [id], onUpdate: NoAction, map: "application_stage_history_changed_by_user_id_fk")
  fromStage       RecruitmentStage? @relation("StageHistoryFrom", fields: [fromStageId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "application_stage_history_from_stage_id_fk")
  toStage         RecruitmentStage  @relation("StageHistoryTo", fields: [toStageId], references: [id], onUpdate: NoAction, map: "application_stage_history_to_stage_id_fk")

  @@index([applicationId, createdAt(sort: Desc)], map: "application_stage_history_application_created_idx")
  @@map("application_stage_history")
}

model AiPipelineVersion {
  id              String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code            String                @unique(map: "ai_pipeline_versions_code_uq")
  pipelineType    String                @map("pipeline_type")
  semanticVersion String                @map("semantic_version")
  codeRevision    String?               @map("code_revision")
  config          Json                  @default("{}")
  isActive        Boolean               @default(true) @map("is_active")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  matchRuns       ApplicationMatchRun[]
  parseRuns       ResumeParseRun[]

  @@map("ai_pipeline_versions")
}

model ResumeParseRun {
  id                String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  resumeVersionId   String                @map("resume_version_id") @db.Uuid
  pipelineVersionId String                @map("pipeline_version_id") @db.Uuid
  status            String                @default("PENDING")
  rawText           String?               @map("raw_text")
  rawOutput         Json?                 @map("raw_output")
  detectedLanguage  String?               @map("detected_language")
  warnings          Json?
  startedAt         DateTime?             @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime?             @map("completed_at") @db.Timestamptz(6)
  errorCode         String?               @map("error_code")
  errorMessage      String?               @map("error_message")
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  matchRuns         ApplicationMatchRun[]
  educations        ResumeEducation[]
  experiences       ResumeExperience[]
  pipelineVersion   AiPipelineVersion     @relation(fields: [pipelineVersionId], references: [id], onUpdate: NoAction, map: "resume_parse_runs_pipeline_version_id_fk")
  resumeVersion     ResumeVersion         @relation(fields: [resumeVersionId], references: [id], onUpdate: NoAction, map: "resume_parse_runs_resume_version_id_fk")
  skills            ResumeSkill[]

  @@index([resumeVersionId, createdAt(sort: Desc)], map: "resume_parse_runs_version_created_idx")
  @@map("resume_parse_runs")
}

model ResumeSkill {
  id           String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  parseRunId   String             @map("parse_run_id") @db.Uuid
  skillId      String             @map("skill_id") @db.Uuid
  confidence   Decimal?           @db.Decimal(7, 6)
  evidenceText String?            @map("evidence_text")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  matchResults MatchSkillResult[]
  parseRun     ResumeParseRun     @relation(fields: [parseRunId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "resume_skills_parse_run_id_fk")
  skill        Skill              @relation(fields: [skillId], references: [id], onUpdate: NoAction, map: "resume_skills_skill_id_fk")

  @@unique([parseRunId, skillId], map: "resume_skills_parse_skill_uq")
  @@index([skillId], map: "resume_skills_skill_idx")
  @@map("resume_skills")
}

model ResumeExperience {
  id               String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  parseRunId       String         @map("parse_run_id") @db.Uuid
  companyName      String?        @map("company_name")
  jobTitle         String?        @map("job_title")
  startDate        DateTime?      @map("start_date") @db.Date
  endDate          DateTime?      @map("end_date") @db.Date
  isCurrent        Boolean        @default(false) @map("is_current")
  description      String?
  experienceMonths Int?           @map("experience_months")
  ordinal          Int            @default(0)
  confidence       Decimal?       @db.Decimal(7, 6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  parseRun         ResumeParseRun @relation(fields: [parseRunId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "resume_experiences_parse_run_id_fk")

  @@index([parseRunId, ordinal], map: "resume_experiences_parse_ordinal_idx")
  @@map("resume_experiences")
}

model ResumeEducation {
  id              String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  parseRunId      String         @map("parse_run_id") @db.Uuid
  institutionName String?        @map("institution_name")
  degree          String?
  fieldOfStudy    String?        @map("field_of_study")
  startDate       DateTime?      @map("start_date") @db.Date
  endDate         DateTime?      @map("end_date") @db.Date
  description     String?
  ordinal         Int            @default(0)
  confidence      Decimal?       @db.Decimal(7, 6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  parseRun        ResumeParseRun @relation(fields: [parseRunId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "resume_educations_parse_run_id_fk")

  @@index([parseRunId, ordinal], map: "resume_educations_parse_ordinal_idx")
  @@map("resume_educations")
}

model ApplicationMatchRun {
  id                     String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  applicationId          String                @map("application_id") @db.Uuid
  resumeParseRunId       String                @map("resume_parse_run_id") @db.Uuid
  jobVersionId           String                @map("job_version_id") @db.Uuid
  pipelineVersionId      String                @map("pipeline_version_id") @db.Uuid
  status                 String                @default("PENDING")
  overallScore           Decimal?              @map("overall_score") @db.Decimal(5, 2)
  startedAt              DateTime?             @map("started_at") @db.Timestamptz(6)
  completedAt            DateTime?             @map("completed_at") @db.Timestamptz(6)
  errorCode              String?               @map("error_code")
  errorMessage           String?               @map("error_message")
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  application            Application           @relation("ApplicationMatchRuns", fields: [applicationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "application_match_runs_application_id_fk")
  jobVersion             JobVersion            @relation(fields: [jobVersionId], references: [id], onUpdate: NoAction, map: "application_match_runs_job_version_id_fk")
  pipelineVersion        AiPipelineVersion     @relation(fields: [pipelineVersionId], references: [id], onUpdate: NoAction, map: "application_match_runs_pipeline_version_id_fk")
  resumeParseRun         ResumeParseRun        @relation(fields: [resumeParseRunId], references: [id], onUpdate: NoAction, map: "application_match_runs_resume_parse_run_id_fk")
  currentForApplications Application[]         @relation("ApplicationCurrentMatchRun")
  components             MatchScoreComponent[]
  skillResults           MatchSkillResult[]

  @@unique([id, applicationId], map: "application_match_runs_id_application_uq")
  @@index([applicationId, createdAt(sort: Desc)], map: "application_match_runs_application_created_idx")
  @@index([jobVersionId, overallScore(sort: Desc)], map: "application_match_runs_job_score_idx", where: raw("(status = 'SUCCEEDED'::text)"))
  @@map("application_match_runs")
}

model MatchScoreComponent {
  id            String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  matchRunId    String              @map("match_run_id") @db.Uuid
  componentCode String              @map("component_code")
  rawScore      Decimal             @map("raw_score") @db.Decimal(5, 2)
  weight        Decimal             @db.Decimal(7, 6)
  weightedScore Decimal             @map("weighted_score") @db.Decimal(9, 6)
  details       Json?
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  matchRun      ApplicationMatchRun @relation(fields: [matchRunId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "match_score_components_match_run_id_fk")

  @@unique([matchRunId, componentCode], map: "match_score_components_run_component_uq")
  @@map("match_score_components")
}

model MatchSkillResult {
  id                String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  matchRunId        String              @map("match_run_id") @db.Uuid
  jobVersionSkillId String              @map("job_version_skill_id") @db.Uuid
  resumeSkillId     String?             @map("resume_skill_id") @db.Uuid
  status            String
  similarityScore   Decimal?            @map("similarity_score") @db.Decimal(7, 6)
  evidenceText      String?             @map("evidence_text")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  jobVersionSkill   JobVersionSkill     @relation(fields: [jobVersionSkillId], references: [id], onUpdate: NoAction, map: "match_skill_results_job_version_skill_id_fk")
  matchRun          ApplicationMatchRun @relation(fields: [matchRunId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "match_skill_results_match_run_id_fk")
  resumeSkill       ResumeSkill?        @relation(fields: [resumeSkillId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "match_skill_results_resume_skill_id_fk")

  @@unique([matchRunId, jobVersionSkillId], map: "match_skill_results_match_run_skill_uq")
  @@index([matchRunId, status], map: "match_skill_results_run_status_idx")
  @@map("match_skill_results")
}
