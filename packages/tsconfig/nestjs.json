{
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "sourceMap": true,
    "incremental": true,
    "isolatedModules": true,
    "emitDecoratorMetadata": true,
